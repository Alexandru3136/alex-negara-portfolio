# Copy to .env and fill in. Do NOT commit your real .env (it is gitignored).

# Server port (default 3000).
PORT=3000

# Admin panel password.
# - Set it to enable admin login (required in production).
# - If unset in development, a random password is generated and printed once at startup.
ADMIN_PASSWORD=

# Session signing key. Optional: if unset it is derived from ADMIN_PASSWORD.
# Recommended to set an explicit random value in production.
SESSION_SECRET=

# KV REST store (Vercel KV / Upstash) for persistent data + shared rate limiting.
# When both are set, storage and login throttling use KV instead of the local
# filesystem / in-memory maps. Required for admin edits to persist on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Key under which the portfolio document is stored (default: portfolio).
KV_KEY=portfolio
